# Copy this file to .env and fill in the values. .env is git-ignored.
# Both docker compose and the app read it.

DB_URL=jdbc:postgresql://localhost:5433/chama
DB_USERNAME=chama
DB_PASSWORD=change-me

# The first recorder account, created only when the database has no users.
# Password: at least 12 characters.
ADMIN_USERNAME=recorder
ADMIN_PASSWORD=change-me-to-something-long
